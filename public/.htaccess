# LP Stamp Paper on Hostinger. LiteSpeed reads this the way Apache does.
#
# The site is static files: `npm run build` writes it to out/, and this file
# goes with it into public_html. It does the jobs the Next server used to do —
# clean URLs, the old district redirects, the security headers and the 404.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# The export writes /about as about.html beside a folder about/ (the data the
# browser fetches when it navigates there), so most names are both a page and a
# folder. Left on, this would bounce /about to /about/ before the rewrite below
# got the chance to serve the page.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The credentials the build leaves beside orders.php are for PHP to read,
  # never for a browser to fetch.
  RewriteRule ^api/orders-config\.php$ - [F,L]

  # The location pages moved from a mixed city/district list to the 38 official
  # districts. These slugs were towns, not districts — keep the old URLs alive
  # so nothing already indexed 404s.
  RewriteRule ^(rental-agreement|stamp-paper)/trichy/?$ /$1/tiruchirappalli [R=301,L]
  RewriteRule ^(rental-agreement|stamp-paper)/hosur/?$ /$1/krishnagiri [R=301,L]
  RewriteRule ^(rental-agreement|stamp-paper)/ooty/?$ /$1/nilgiris [R=301,L]
  RewriteRule ^(rental-agreement|stamp-paper)/nagercoil/?$ /$1/kanyakumari [R=301,L]
  RewriteRule ^(rental-agreement|stamp-paper)/karaikudi/?$ /$1/sivaganga [R=301,L]
  RewriteRule ^(rental-agreement|stamp-paper)/villupuram/?$ /$1/viluppuram [R=301,L]
  RewriteRule ^(rental-agreement|stamp-paper)/kanchipuram/?$ /$1/kancheepuram [R=301,L]
  RewriteRule ^(rental-agreement|stamp-paper)/tirupattur/?$ /$1/tirupathur [R=301,L]

  # Clean URLs: /about and /about/ both serve about.html. Served rather than
  # redirected, so it cannot loop against a server that adds the slash itself;
  # every page names its canonical URL, so the slash form is not a duplicate.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} ^(.+?)/?$
  RewriteCond %1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Social cards are written without an extension, so say what they are.
<FilesMatch "^opengraph-image">
  ForceType image/png
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Every script, stylesheet and web font the build emits lives under
# /_next/static with a content hash in its name, so a year is safe: a new build
# ships new names. Pages themselves are left to revalidate.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
